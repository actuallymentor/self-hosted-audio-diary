# Host bind mounts
APP_VERSION=0.2.0
APP_DATA_PATH=./data/app
DIARY_DATA_PATH=./data/diary
TRANSCRIPTION_MODEL_CACHE_PATH=./data/models

# Plain HTTP application listener
APP_PORT=3000
APP_UID=10001
APP_GID=10001
SESSION_COOKIE_SECURE=false
SESSION_TTL_DAYS=30
UPLOAD_TTL_DAYS=30

# Local multilingual transcription
TRANSCRIPTION_URL=http://transcriber:8000
TRANSCRIPTION_MODEL=large-v3
TRANSCRIPTION_MODEL_REVISION=edaa852ec7e145841d8ffdb056a99866b5f0a478
TRANSCRIPTION_COMPUTE_TYPE=int8
TRANSCRIPTION_CPU_THREADS=auto
HF_TOKEN=

# OpenRouter reflection and speech
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
OPENROUTER_ZDR_ONLY=true
TTS_PROVIDER=openrouter
TTS_MODEL=google/gemini-3.1-flash-tts-preview
TTS_VOICE=Sulafat
TTS_RESPONSE_FORMAT=pcm

# Live test switches
RUN_OPENROUTER_TESTS=false
RUN_TTS_TESTS=false

# Publishing: CI only, never application containers
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=
DOCKERHUB_APP_IMAGE=
DOCKERHUB_TRANSCRIBER_IMAGE=
